# Copy to .env and fill in. Never commit the real .env.
# Generate strong values, e.g.:  openssl rand -base64 32
#
# WARNING: if N8N_ENCRYPTION_KEY is lost or changed, every credential saved
# in n8n becomes permanently unreadable. Keep it in a password manager AND
# one second location.

POSTGRES_PASSWORD=changeme
N8N_ENCRYPTION_KEY=changeme

# Least-privilege role for the audit workflow's own Postgres writes,
# separate from POSTGRES_PASSWORD above (which stays n8n's own superuser
# connection to its internal `n8n` database). See postgres_app_role.sql.
# NOTE: unlike POSTGRES_PASSWORD/N8N_ENCRYPTION_KEY, docker-compose.yml does
# NOT read this variable — nothing here is auto-substituted. This is a
# record/backup location only; the real value must be pasted directly into
# postgres_app_role.sql's CREATE ROLE statement before running it.
A11YAUDIT_APP_PASSWORD=changeme
