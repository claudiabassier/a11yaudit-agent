# Copy to .env and fill in. Never commit the real .env.
# Generate strong values, e.g.:  openssl rand -base64 32
#
# WARNING: if N8N_ENCRYPTION_KEY is lost or changed, every credential saved
# in n8n becomes permanently unreadable. Keep it in a password manager AND
# one second location.

POSTGRES_PASSWORD=changeme
N8N_ENCRYPTION_KEY=changeme
