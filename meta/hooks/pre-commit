#!/bin/bash
# meta/hooks/pre-commit — blocks a commit on the fast, deterministic
# documentation-integrity checks this project has: decision_log.md's own
# completeness claim, readme.md/CLAUDE.md's table/view counts against the
# real schema, and meta/'s own file registry (every check script actually
# documented and wired in — the exact table that has gone stale three
# times, decision_log.md D-96).
#
# Why this exists as a local hook, not just a CI check: branch protection
# is currently blocked on this private free-tier repo (decision_log.md
# D-86), so a red CI check today is informational only — it does not stop
# a push or a merge. This hook is the one thing that can actually block
# something *today*, at commit time, which is also the moment a fix is
# still fresh enough to write the full entry for — not three reviews and
# eleven commits later (decision_log.md D-93/D-94/D-95).
#
# Install (once per clone):
#   git config core.hooksPath meta/hooks
# This repo's own working copy already has that set — see build_runbook.md.

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

run_check() {
  local script="$1" what="$2"
  if [ -f "$script" ]; then
    if ! bash "$script"; then
      echo
      echo "pre-commit: $what — see above."
      echo "To bypass in a genuine emergency: git commit --no-verify (leaves the gap for the next check to catch)."
      exit 1
    fi
  fi
}

run_check meta/check_decision_log_completeness.sh \
  "decision_log.md's completeness claim does not match its own body"
run_check meta/check_doc_schema_numbers.sh \
  "readme.md/CLAUDE.md's table/view count claims don't match postgres_schema.sql"
run_check meta/check_meta_registry.sh \
  "meta/'s own file registry (README table / checks.yml wiring) is incomplete"
